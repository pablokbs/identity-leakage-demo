# Identity Leakage Demo configuration
# Copy this file to 00-config.sh and fill in real values.
# 00-config.sh must NEVER be committed; it is git-ignored.

# === Identity behind which the test repo lives ===
OWNER=""            # your GitHub username or org name (e.g. "pablokbs")
REPO=""             # reusable, pre-created test repo (e.g. "identity-leakage-demo")

# === Token belonging to YOUR account ===
# Used by setup, remediation, and cleanup to create demo branches/PRs and
# configure protection. This is deliberately separate from the credentials
# held by the simulated agent. Permanent deletion also requires delete_repo.
TEST_ORG_GH_TOKEN=""

# === Two demo personas ===
# GitHub usernames of the accounts you invited as collaborators.
ADMIN_HANDLE=""     # account with Admin role on the repo
WRITER_HANDLE=""    # account with Write (not Admin) role on the repo

# === Fine-grained PATs belonging to those personas ===
# Each PAT is scoped ONLY to the test repo above, with these permissions:
#   - Contents: Read and write
#   - Pull requests: Read and write
#   - Metadata: Read-only (auto-selected)
#   - Administration: NO ACCESS
# The ONLY difference between the two tokens is the user that owns them.
ADMIN_TOKEN=""      # fine-grained PAT of ADMIN_HANDLE
WRITER_TOKEN=""     # fine-grained PAT of WRITER_HANDLE

# === Safety ===
# The demo refuses to run if OWNER matches any of the names below, or
# if REPO matches a production-like name. Edit lib.sh to add your own.
